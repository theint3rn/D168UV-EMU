flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flashAlias: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x4000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x38000

xmc: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x1000000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 15000000    // stock + cfw: 15 ticks/us (DAT 0x20001808), LOAD 74999 = 5 ms OS tick
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

dma1: DMA.STM32G0DMA @ sysbus 0x40020000
    numberOfChannels: 7
    [0-6] -> nvic@[11-17]

dma2: DMA.STM32G0DMA @ sysbus 0x40020400
    numberOfChannels: 5
    [0-4] -> nvic@[56-60]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 19
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    -> nvic@37
    DMARequest -> dma1@4 | dma1@5

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38
    DMARequest -> dma1@6 | dma1@7

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39
    DMARequest -> dma1@2 | dma1@3

usart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52
    DMARequest -> dma2@3 | dma2@5

usart5: UART.STM32_UART @ sysbus <0x40005000, +0x100>
    -> nvic@53

i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32
    TxDMARequest -> dma1@6
    RxDMARequest -> dma1@7

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34
    TxDMARequest -> dma1@4
    RxDMARequest -> dma1@5

gpioPortA: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010800, +0x400>
    invertedAFPins: [[7, 1]]

gpioPortB: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010C00, +0x400>
    invertedAFPins: [[13, 1], [14, 1], [15, 1], [0, 1], [1, 1]]

gpioPortC: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011000, +0x400>

gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>

gpioPortE: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011800, +0x400>
    invertedAFPins: [[8, 1], [10, 1], [12, 1]]

gpioPortF: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011C00, +0x400>

gpioPortG: GPIOPort.STM32F1GPIOPort @ sysbus <0x40012000, +0x400>

timer1: Timers.STM32_Timer @ sysbus 0x40012c00
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25 | dma1@5
    TriggerInterrupt -> nvic@26 | dma1@4
    CommutationInterrupt -> nvic@26 | dma1@4
    CaptureCompareInterrupt -> nvic@27 | dma1@2
    frequency: 10000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    IRQ -> nvic@28
    UpdateInterrupt -> dma1@2
    frequency: 10000000
    initialLimit: 0xFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    IRQ -> nvic@29
    UpdateInterrupt -> dma1@3
    TriggerInterrupt -> dma1@6
    frequency: 10000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    IRQ -> nvic@30
    UpdateInterrupt -> dma1@7
    [0-2] -> dma1@[1, 4, 5]
    frequency: 10000000
    initialLimit: 0xFFFF

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    IRQ -> nvic@50
    TriggerInterrupt -> dma2@1
    UpdateInterrupt -> dma2@2
    [0-2] -> dma2@[5, 4, 2]
    frequency: 10000000
    initialLimit: 0xFFFF

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    IRQ -> nvic@54
    UpdateInterrupt -> dma2@3
    frequency: 10000000
    initialLimit: 0xFFFF

timer7: Timers.STM32_Timer @ sysbus 0x40001400
    IRQ -> nvic@55
    UpdateInterrupt -> dma2@4
    frequency: 10000000
    initialLimit: 0xFFFF

timer8: Timers.STM32_Timer @ sysbus 0x40013400
    BreakInterrupt -> nvic@43
    UpdateInterrupt -> nvic@44 | dma2@1
    TriggerInterrupt -> nvic@45 | dma2@2
    CommutationInterrupt -> nvic@45 | dma2@2
    CaptureCompareInterrupt -> nvic@46
    [0-3] -> dma2@[3, 5, 1, 2]
    frequency: 10000000
    initialLimit: 0xFFFF

timer9: Timers.STM32_Timer @ sysbus 0x40014c00
    IRQ -> nvic@24
    frequency: 10000000
    initialLimit: 0xFFFF

timer10: Timers.STM32_Timer @ sysbus 0x40015000
    IRQ -> nvic@25
    frequency: 10000000
    initialLimit: 0xFFFF

timer11: Timers.STM32_Timer @ sysbus 0x40015400
    IRQ -> nvic@26
    frequency: 10000000
    initialLimit: 0xFFFF

timer12: Timers.STM32_Timer @ sysbus 0x40001800
    IRQ -> nvic@43
    frequency: 10000000
    initialLimit: 0xFFFF

timer13: Timers.STM32_Timer @ sysbus 0x40001C00
    IRQ -> nvic@44
    frequency: 10000000
    initialLimit: 0xFFFF

timer14: Timers.STM32_Timer @ sysbus 0x40002000
    IRQ -> nvic@45
    frequency: 10000000
    initialLimit: 0xFFFF

afio: GPIOPort.STM32F1AFIO @ sysbus 0x40010000
    gpioPorts: [gpioPortA, gpioPortB, gpioPortC, gpioPortD, gpioPortE, gpioPortF, gpioPortG]
    [0-15] -> exti@[0-15]

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ -> nvic@35

spi2: Miscellaneous.D168Baseband @ sysbus <0x40003800, +0x400>
    IRQ -> nvic@36

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    series: STM32Series.F4
    IRQ -> nvic@51

crm: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    filename: "MODELS/crm.py"



// ---- front panel: parallel TFT (PE7..14 data, PD15 WR, PD14 CS, PD12 D/C), same wiring as the D890UV ----
lcd: Miscellaneous.D890LcdKeypad @ sysbus <0x5FFF0200, +0x10>
    width: 160
    height: 128
    // key matrix FUN_0804339c: rows PE7..PE12 driven low, columns PC5 / PB1 / PB2 read (active low):
    // run.py sends `lcd Layout "d168"` (LcdKeypad.cs)
    Col0 -> gpioPortC@5
    Col1 -> gpioPortB@1
    Col2 -> gpioPortB@2

gpioPortE:
    [7-14] -> lcd@[0-7]

gpioPortD:
    15 -> lcd@8
    14 -> lcd@9
    12 -> lcd@10

// ---- external SPI-NAND (Kioxia 2 Gbit), bit-banged: CS# PE2, SCK PB11, MOSI PB10, MISO PA15 ----
nand: Miscellaneous.D168SpiNand @ sysbus <0x5FFF0000, +0x10>
    pagesFile: "IMAGES/extflash.pages"
    IO1 -> gpioPortA@15

gpioPortE:
    2 -> nand@0

gpioPortB:
    11 -> nand@1
    10 -> nand@2

// ---- board: key / detect input levels (idle); D3 = RF-chip VOX detect line (low = voice, stock 0x08099B4C) ----
board: Miscellaneous.D168BoardInputs @ sysbus <0x5FFF0100, +0x10>
    levels: "A0=0,A10=1,A13=1,A14=1,D0=1,B8=1,D3=1"

// ---- RF transceiver, 3-wire bus: SCK PB3, SDA PB4, CS# PB5 (same chip and wiring as the D890UV rf0) ----
rf0: Miscellaneous.D890RfTransceiver @ sysbus <0x5FFF0300, +0x10>
    Sda -> gpioPortB@4

gpioPortB:
    5 -> rf0@0
    3 -> rf0@1
    4 -> rf0@2

// ---- bit-banged I2C: SDA PB6, SCL PB7 (FM receiver 0x10, accelerometer 0x19) ----
i2c: Miscellaneous.D168I2cBus @ sysbus <0x5FFF0500, +0x10>

gpioPortB:
    6 -> i2c@0
    7 -> i2c@1

// ---- channel knob: quadrature encoder PC8 (A) / PC9 (B), EXTI9_5 (IRQ23_Handler) ----
knob: Miscellaneous.D168Knob @ sysbus <0x5FFF0430, +0x10>

// ---- RTC (F1 style seconds counter, IRQ 3), host time at first start ----
rtc: Miscellaneous.D168Rtc @ sysbus <0x40002800, +0x400>
    IRQ -> nvic@3

// ---- Bluetooth module on UART4 (AT commands, answers AT+VER? etc.; models/Bt168.cs) ----
bt: Miscellaneous.D168Bluetooth @ sysbus <0x5FFF0800, +0x10>

// ---- GPS receiver on USART2 (NMEA, one fix per virtual second; models/Gps168.cs) ----
gps: Miscellaneous.D168Gps @ sysbus <0x5FFF0810, +0x10>
